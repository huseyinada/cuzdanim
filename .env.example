# Bu dosyayı `.env` olarak kopyala (basla.bat bunu otomatik yapar).

APP_NAME="Cüzdanım"
ENVIRONMENT=development
DEBUG=false

# Yerel demo (SQLite, async):
DATABASE_URL=sqlite+aiosqlite:///./finance_tracker.db
# Üretim örneği (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://finance_user:finance_pass@localhost:5432/finance_tracker
DATABASE_ECHO=false

# Güçlü bir anahtar üret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_super_secret_key_please_replace_in_production_env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Kategori bütçesinin yüzde kaçında uyarı üretilsin (0.8 = %80)
BUDGET_ALERT_THRESHOLD=0.8
CURRENCY_SYMBOL=₺

# Zamanlayıcı — tüm saatler bu dilimde
SCHEDULER_TIMEZONE=Europe/Istanbul
ENABLE_SCHEDULER=true
DAILY_MESSAGE_HOUR=8      # sabah motivasyon bildirimi saati
DAILY_MESSAGE_MINUTE=0
BUDGET_CHECK_HOUR=20      # akşam bütçe kontrolü saati

# Web Push (VAPID). Boş bırakılırsa ilk çalıştırmada vapid_keys.json'a otomatik üretilir.
# Bulut sunucuda (Render vb.) `python -m app.tools.vapid` çıktısını buraya yapıştır.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com
VAPID_KEYS_FILE=vapid_keys.json

CORS_ORIGINS=["http://localhost:8000","http://localhost:3000","http://localhost:5173"]
